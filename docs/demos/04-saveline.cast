[17.266662, "o", "\u001b[?25l\u001b[1m\u001b[HSaving to the vault\u001b[m\u000f (Ctrl+C aborts). Turn the parts that change into <placeholders>.\u001b[K\r\nCommand: rsync -avz --progress ./ <host>:~/project/\u001b[K\r\nDescription: Sync this directory to a drone\u001b[K\u001b[2m\r\nTags in use: backup, disk, git, network, ports, python, ssh, tar, venv\u001b[m\u000f\u001b[K\r\nTags (comma separated, the first one picks the file): rsync, uav\u001b[K\r\nValues for <host> (a, b, c | !command | empty: typed when used): uav1, uav2, uav3\u001b[K\r\nSaved to cheats/rsync.cheat\u001b[K\u001b[32m\u001b[1m\r\nyou@laptop\u001b[m\u000f:\u001b[34m\u001b[1m~/project\u001b[m\u000f$ rsync -avz --progress ./ uav1:~/project/\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[38;5;250m\u001b[48;5;237m\r\n \u001b[1mbash in tmux\u001b[m\u000f\u001b[38;5;250m\u001b[48;5;237m                                           \u001b[38;5;16m\u001b[48;5;214m\u001b[1m saved, and the line is still on the prompt \u001b[m\u000f\u001b[34h\u001b[?25h\u001b[8;63H"]
