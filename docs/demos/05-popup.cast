[3.938639, "o", "\u001b[10;6H\u001b[38;5;161m\u001b[48;5;236m\u001b[1m\u258c\u001b[m\u000f\u001b[48;5;236m \u001b[96m\u001b[1mgit              \u001b[38;5;254m  \u2800\u001b[94mUndo the last commit but keep its chang\u2026\u001b[38;5;254m  \u2800\u001b[97mgit reset --soft HEA\u00b7\u00b7\u001b[m\u000f \u001b[11;6H\u001b[38;5;236m\u258c\u001b[39m \u001b[96mssh              \u001b[39m  \u2800\u001b[94mCopy my SSH key to a machine            \u001b[39m  \u2800\u001b[97mssh-copy-id -i ~/.ss\u00b7\u00b7\u001b[39m \u001b[12;6H\u001b[38;5;236m\u258c\u001b[39m \u001b[96mnetwork, ports   \u001b[39m  \u2800\u001b[94mWhich process is listening on a port    \u001b[39m  \u2800\u001b[97msudo ss -ltnp | grep\u00b7\u00b7\u001b[39m \u001b[13;6H\u001b[38;5;236m\u258c\u001b[39m \u001b[96mbackup, tar      \u001b[39m  \u2800\u001b[94mArchive a directory into a .tar.gz      \u001b[39m  \u2800\u001b[97mtar czvf <archive>.t\u00b7\u00b7\u001b[39m \u001b[14;6H\u001b[38;5;236m\u258c\u001b[39m \u001b[96mrsync, uav       \u001b[39m  \u2800\u001b[94mSync this directory to a drone          \u001b[39m  \u2800\u001b[97mrsync -avz --progres\u00b7\u00b7\u001b[39m \u001b[15;6H\u001b[38;5;236m\u258c\u001b[39m \u001b[96mdisk             \u001b[39m  \u2800\u001b[94mBiggest directories under a path        \u001b[39m  \u2800\u001b[97mdu -h --max-depth=1 \u00b7\u00b7\u001b[39m \u001b[16;6H\u001b[38;5;236m\u258c\u001b[39m \u001b[96mpython, venv     \u001b[39m  \u2800\u001b[94mCreate and activate a Python venv       \u001b[39m  \u2800\u001b[97mpython3 -m venv .ven\u00b7\u00b7\u001b[39m \u001b[9;6H  \u001b[38;5;144m7/7\u001b[38;5;59m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u250