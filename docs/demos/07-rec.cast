[11.985387, "o", "\u001b[14;1H\u001b[38;5;161m\u001b[48;5;236m\u001b[1m\u258c\u001b[m\u000f\u001b[48;5;236m \u001b[38;5;254m\u001b[1mWhich process is listening on a \u001b[38;5;151mport\u001b[38;5;254m  [network, ports]  sudo ss -ltnp | grep ':<port>'\r\n\u001b[m\u000f\u001b[38;5;236m\u258c\u001b[39m Sync this directory to a drone  [rsync, uav]  rsync -avz --\u001b[38;5;108mp\u001b[39mr\u001b[38;5;108mo\u001b[39mg\u001b[38;5;108mr\u001b[39mess ./ <hos\u001b[38;5;108mt\u001b[39m>:~/project/\r\n\u001b[38;5;236m\u258c\u001b[39m Biggest directories under a path  [disk]  du -h --max-de\u001b[38;5;108mp\u001b[39mth=1 <dir> | s\u001b[38;5;108mort\u001b[39m -rh | head -n 15\r\n\u001b[38;5;236m\u258c\u001b[39m \u00b7\u00b7and activate a Python venv  [python, venv]  \u001b[38;5;108mp\u001b[39mython3 -m venv .venv && \\s\u001b[38;5;108mo\u001b[39mu\u001b[38;5;108mr\u001b[39mce .venv/bin/ac\u001b[38;5;108mt\u001b[39mivate\r\n\u001b[38;5;236m\u258c\u001b[39m Co\u001b[38;5;108mp\u001b[39my my SSH key to a machine  [ssh]  ssh-c\u001b[38;5;108mo\u001b[39mpy-id -i ~/.ssh/id_ed25519.pub <use\u001b[38;5;108mr\u001b[39m>@<hos\u001b[38;5;108mt\u001b[39m>\u001b[13;1H  \u001b[38;5;144m5/7\u001b[38;5;59m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m \u001b[12;20H"]
