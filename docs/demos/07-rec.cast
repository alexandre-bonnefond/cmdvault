[8.966402, "o", "\u001b[?25l\u001b[32m\u001b[1m\u001b[Hyou@laptop\u001b[m\u000f:\u001b[34m\u001b[1m~/project\u001b[m\u000f$ rec ports\u001b[K\u001b[1m\r\nRecording ports\u001b[m\u000f, exit the shell (Ctrl+D) to stop.\u001b[K\u001b[32m\u001b[1m\r\nyou@laptop\u001b[m\u000f:\u001b[34m\u001b[1m~/project\u001b[m\u000f$ ss -ltn | head -5\u001b[K\r\nState  Recv-Q Send-Q                          Local Address:Port  Peer Address:PortProcess\u001b[K\r\nLISTEN 0      4096                                127.0.0.1:631        0.0.0.0:*          \u001b[K\r\nLISTEN 0      128                                 127.0.0.1:33677      0.0.0.0:*          \u001b[K\r\nLISTEN 0      1024                                127.0.0.1:36743      0.0.0.0:*          \u001b[K\r\nLISTEN 0      511                                 127.0.0.1:19364      0.0.0.0:*          \u001b[K\u001b[32m\u001b[1m\r\nyou@laptop\u001b[m\u000f:\u001b[34m\u001b[1m~/project\u001b[m\u000f$ exit\u001b[K\r\nexit\u001b[K\r\nSaved recordings/ports.cast\u001b[K\u001b[38;5;110m\u001b[1m\r\nports:\u001b[m\u000f\u001b[38;5;110m \u001b[39m\u001b[K\u001b[38;5;59m\r\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m \u001b[38;5;161m\u001b[48;5;236m\u001b[1m\u001b[14;1H\u258c\u001b[m\u000f\u001b[48;5;236m \u001b[38;5;254m\u001b[1mSave a new entry with it\u001b[m\u000f                        \u001b[K\u001b[38;5;236m\r\n\u258c\u001b[39m Link it to an existing entry                    \u001b[K\u001b[38;5;236m\r\n\u258c\u001b[39m Keep it unlinked       \u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[38;5;250m\u001b[48;5;237m\r\n \u001b[1mbash in tmux\u001b[m\u000f\u001b[38;5;250m\u001b[48;5;237m                                              \u001b[38;5;16m\u001b[48;5;214m\u001b[1m link the recording to an existing entry \u001b[m\u000f\u001b[34h\u001b[?25h\u001b[12;8H"]
