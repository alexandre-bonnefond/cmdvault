[10.814397, "o", "\u001b[38;5;110m\u001b[1mLink ports to:\u001b[m\u000f\u001b[38;5;110m \r\n\u001b[38;5;148m\u001b[1m\u2819\u001b[m\u000f \u001b[38;5;144m0/0\u001b[38;5;59m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m \u001b[14;1H\u001b[38;5;161m\u001b[48;5;236m\u001b[1m\u258c\u001b[m\u000f\u001b[48;5;236m \u001b[38;5;254m\u001b[1mArchive a directory into a .tar.gz  [backup, tar]  tar czvf <archive>.tar.gz <dir>\u001b[m\u000f                \u001b[15;1H\u001b[38;5;236m\u258c\u001b[39m Biggest directories under a path  [disk]  du -h --max-depth=1 <dir> | sort -rh | head -n 15       \u001b[16;1H\u001b[38;5;236m\u258c\u001b[39m Undo the last commit but keep its changes staged\u001b[2C[git]  git reset --soft HEAD~1                  \u001b[17;1H\u001b[38;5;236m\u258c\u001b[39m Which process is listening on a port  [network, ports]  sudo ss -ltnp | grep ':<port>'            \u001b[18;1H\u001b[38;5;236m\u258c\u001b[39m Create and activate a Python venv  [python, venv]  python3 -m venv .venv && \\source .venv/bin/a\u00b7\u00b7 \u001b[19;1H\u001b[38;5;236m\u258c\u001b[39m Sync this directory to a drone  [rsync, uav]  rsync -avz --progress ./ <host>:~/project/          \u001b[20;1H\u001b[38;5;236m\u258c\u001b[39m Copy my SSH key to a machine  [ssh]  ssh-copy-id\u001b[C-i ~/.ssh/id_ed25519.pub <user>@<host>           \u001b[13;1H  \u001b[38;5;144m7/7\u001b[38;5;59m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m \u001b[12;16H"]
[10.899804, "o", "\r\n  \u001b[38;5;144m7/7\u001b[38;5;59m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m \u001b[12;16H"]
[11.802341, "o", "\r                         \r\u001b[38;5;110m\u001b[1mLink ports to:\u001b[m\u000f\u001b[38;5;110m \u001b[39m\u001b[1mp\u001b[m\u000f"]
[11.803588, "o", "\u001b[14;1H\u001b[38;5;161m\u001b[48;5;236m\u001b[1m\u258c\u001b[m\u000f\u001b[48;5;236m \u001b[38;5;254m\u001b[1mWhich \u001b[38;5;151mp\u001b[38;5;254mrocess is listening on a port  [network, ports]  sudo ss -ltnp | grep ':<port>'\r\n\u001b[m\u000f\u001b[38;5;236m\u258c\u001b[39m Biggest directories under a \u001b[38;5;108mp\u001b[39math  [disk]  du -h --max-depth=1 <dir> | sort -rh | head -n 15\r\n\u001b[38;5;236m\u258c\u001b[39m Create and activate a \u001b[38;5;108mP\u001b[39mython venv  [python, venv]  python3 -m venv .venv && \\source .venv/bin/a\u00b7\u00b7\r\n\u001b[38;5;236m\u258c\u001b[39m Copy my SSH key to a machine  [ssh]  ssh-copy-id -i ~/.ssh/id_ed25519.\u001b[38;5;108mp\u001b[39mub <user>@<host>\r\n\u001b[38;5;236m\u258c\u001b[39m Sync this directory to a drone  [rsync, uav]  rsync -avz --\u001b[38;5;108mp\u001b[39mrogress ./ <host>:~/project/         \r\n\u001b[38;5;236m\u258c\u001b[39m Undo the last commit but kee\u001b[38;5;108mp\u001b[39m its changes staged  [git]  git reset --soft HEAD~1        \r\n\u001b[38;5;236m\u258c\u001b[39m Archive a directory into a .tar.gz  [backu\u001b[38;5;108mp\u001b[39m, tar]  tar czvf <archive>.tar.gz <dir>     \u001b[13;1H  \u001b[38;5;144m7/7\u001b[38;5;59m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m \u001b[12;17H"]
[11.863523, "o", "\r                         \r\u001b[38;5;110m\u001b[1mLink ports to:\u001b[m\u000f\u001b[38;5;110m \u001b[39m\u001b[1mpo\u001b[m\u000f"]
[11.864664, "o", "\u001b[14;1H\u001b[38;5;161m\u001b[48;5;236m\u001b[1m\u258c\u001b[m\u000f\u001b[48;5;236m \u001b[38;5;254m\u001b[1mWhich process is listening on a \u001b[38;5;151mpo\u001b[38;5;254mrt  [network, ports]  sudo ss -ltnp | grep ':<port>'\r\n\u001b[m\u000f\u001b[38;5;236m\u258c\u001b[39m Sync this directory to a drone  [rsync, uav]  rsync -avz --progress ./ <host>:~/\u001b[38;5;108mp\u001b[39mr\u001b[38;5;108mo\u001b[39mject/   \r\n\u001b[38;5;236m\u258c\u001b[39m Create and activate a \u001b[38;5;108mP\u001b[39myth\u001b[38;5;108mo\u001b[39mn venv  [python, venv]  python3 -m venv .venv && \\source .venv/bin/a\u00b7\u00b7\r\n\u001b[38;5;236m\u258c\u001b[39m Copy my SSH key to a machine  [ssh]  ssh-copy-id -i ~/.ssh/id_ed25519.\u001b[38;5;108mp\u001b[39mub <user>@<h\u001b[38;5;108mo\u001b[39mst>\r\n\u001b[38;5;236m\u258c\u001b[39m Undo the last commit but kee\u001b[38;5;108mp\u001b[39m its changes staged  [git]  git reset --s\u001b[38;5;108mo\u001b[39mft HEAD~1        \r\n\u001b[38;5;236m\u258c\u001b[39m Biggest directories under a path  [disk]  du -h --max-de\u001b[38;5;108mp\u001b[39mth=1 <dir> | s\u001b[38;5;108mo\u001b[39mrt -rh | head -n 15\r\n                                                                                                    \u001b[13;1H  \u001b[38;5;144m6/7\u001b[38;5;59m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m \u001b[12;18H"]
