[2.947726, "o", "\u001b[8;1H\u001b[38;5;161m\u001b[48;5;236m\u001b[1m\u258c\u001b[m\u000f\u001b[48;5;236m \u001b[96m\u001b[1mtldr, tar           \u001b[38;5;254m  \u2800\u001b[94mCreate an archive and write it to a file\u001b[38;5;254m  \u2800\u001b[97mtar cf <path_to_target_ta\u2026\u001b[38;5;254m  \u2800\u001b[m\u000f   \u001b[9;1H\u001b[38;5;236m\u258c\u001b[39m \u001b[96mtldr, tar           \u001b[39m  \u2800\u001b[94mCreate a gzipped archive and write it t\u2026\u001b[39m  \u2800\u001b[97mtar czf <path_to_target_t\u2026\u001b[39m  \u2800   \u001b[10;1H\u001b[38;5;236m\u258c\u001b[39m \u001b[96mtldr, tar           \u001b[39m  \u2800\u001b[94mCreate a gzipped (compressed) archive f\u2026\u001b[39m  \u2800\u001b[97mtar czf <path_to_target_t\u2026\u001b[39m  \u2800   \u001b[11;1H\u001b[38;5;236m\u258c\u001b[39m \u001b[96mtldr, tar           \u001b[39m  \u2800\u001b[94mExtract a (compressed) archive file int\u2026\u001b[39m  \u2800\u001b[97mtar xvf <path_to_source_t\u2026\u001b[39m  \u2800   \u001b[12;1H\u001b[38;5;236m\u258c\u001b[39m \u001b[96mtldr, tar           \u001b[39m  \u2800\u001b[94mExtract a (compressed) archive file int\u2026\u001b[39m  \u2800\u001b[97mtar xf <path_to_source_ta\u2026\u001b[39m  \u2800   \u001b[13;1H\u001b[38;5;236m\u258c\u001b[39m \u001b[96mtldr, tar           \u001b[39m  \u2800\u001b[94mCreate a compressed archive and write i\u2026\u001b[39m  \u2800\u001b[97mtar caf <path_to_target_t\u2026\u001b[39m  \u2800   \u001b[14;1H\u001b[38;5;236m\u258c\u001b[39m \u001b[96mtldr, tar           \u001b[39m  \u2800\u001b[94mList the contents of a tar file verbose\u2026\u001b[39m  \u2800\u001b[97mtar tvf <path_to_source_t\u2026\u001b[39m  \u2800   \u001b[15;1H\u001b[38;5;236m\u258c\u001b[39m \u001b[96mtldr, tar           \u001b[39m  \u2800\u001b[94mExtract files matching a pattern from a\u2026\u001b[39m  \u2800\u001b[97mtar xf <path_to_source_ta\u2026\u001b[39m  \u2800   \u001b[7;1H  \u001b[38;5;144m8/8\u001b[38;5;59m \u2500\u2500\u2500\u2500\u2500\u