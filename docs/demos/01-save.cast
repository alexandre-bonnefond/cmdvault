[26.48905, "o", "\u001b[?25l\u001b[32m\u001b[1m\u001b[Hyou@laptop\u001b[m\u000f:\u001b[34m\u001b[1m~/project\u001b[m\u000f$ tar czvf backup.tar.gz notes\u001b[K\r\nnotes/\u001b[K\r\nnotes/todo.md\u001b[K\r\nnotes/2026-10-27.md\u001b[K\u001b[32m\u001b[1m\r\nyou@laptop\u001b[m\u000f:\u001b[34m\u001b[1m~/project\u001b[m\u000f$ save\u001b[K\u001b[1m\r\nSaving to the vault\u001b[m\u000f (Ctrl+C aborts). Turn the parts that change into <placeholders>.\u001b[K\r\nCommand: tar czvf <archive>.tar.gz <dir>\u001b[K\r\nDescription: Archive a directory into a .tar.gz\u001b[K\u001b[2m\r\nTags in use: disk, git, network, ports, ssh\u001b[m\u000f\u001b[K\r\nTags (comma separated, the first one picks the file): backup, tar\u001b[K\r\nValues for <archive> (a, b, c | !command | empty: typed when used): \u001b[K\r\nValues for <dir> (a, b, c | !command | empty: typed when used): notes, src, ~/Documents\u001b[K\r\nSaved to cheats/backup.cheat\u001b[K\u001b[32m\u001b[1m\r\nyou@laptop\u001b[m\u000f:\u001b[34m\u001b[1m~/project\u001b[m\u000f$ \u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[38;5;250m\u001b[48;5;237m\r\n \u001b[1mbash in tmux\u001b[m\u000f\u001b[38;5;250m\u001b[48;5;237m                                             \u001b[38;5;16m\u001b[48;5;214m\u001b[1m saved (and committed in the cheats repo) \u001b[m\u000f\u001b[34h\u001b[?25h\u001b[14;23H"]
[31.01019, "o", "\u001b[?25l\u001b[32m\u001b[1m\u001b[Hyou@laptop\u001b[m\u000f:\u001b[34m\u001b[1m~/project\u001b[m\u000f$ tar czvf backup.tar.gz notes\u001b[K\r\nnotes/\u001b[K\r\nnotes/todo.md\u001b[K\r\nnotes/2026-10-27.md\u001b[K\u001b[32m\u001b[1m\r\nyou@laptop\u001b[m\u000f:\u001b[34m\u001b[1m~/project\u001b[m\u000f$ save\u001b[K\u001b[1m\r\nSaving to the vault\u001b[m\u000f (Ctrl+C aborts). Turn the parts that change into <placeholders>.\u001b[K\r\nCommand: tar czvf <archive>.tar.gz <dir>\u001b[K\r\nDescription: Archive a directory into a .tar.gz\u001b[K\u001b[2m\r\nTags in use: disk, git, network, ports, ssh\u001b[m\u000f\u001b[K\r\nTags (comma separated, the first one picks the file): backup, tar\u001b[K\r\nValues for <archive> (a, b, c | !command | empty: typed when used): \u001b[K\r\nValues for <dir> (a, b, c | !command | empty: typed when used): notes, src, ~/Documents\u001b[K\r\nSaved to cheats/backup.cheat\u001b[K\u001b[32m\u001b[1m\r\nyou@laptop\u001b[m\u000f:\u001b[34m\u001b[1m~/project\u001b[m\u000f$ \u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[38;5;250m\u001b[48;5;237m\r\n \u001b[1mbash in tmux\u001b[m\u000f\u001b[38;5;250m\u001b[48;5;237m                                                                                       \u001b[m\u000f\u001b[34h\u001b[?25h\u001b[14;23H"]
